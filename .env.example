# Copy to a local/staging secret store; do not commit real credentials.
# Netlify runs Next.js. The VPS runs MySQL, Socket.IO and one media API process.
# Split these values between the appropriate service secret stores; do not copy all blindly.
# This loopback database URL is for VPS processes only. Preserve Netlify's existing DB access.
DATABASE_URL=mysql://APP_USER:CHANGE_ME@127.0.0.1:3306/STAGING_DB?connection_limit=3&pool_timeout=10
APP_ORIGIN=https://staging.example.test
NEXT_PUBLIC_SOCKET_URL=https://socket.staging.example.test
# Netlify build-time public setting. Rebuild after changing; no secrets in this URL.
NEXT_PUBLIC_MEDIA_API_URL=https://media.staging.example.test
# VPS media-service-only settings. HTTPS terminates at the existing CloudPanel proxy.
MEDIA_API_PUBLIC_ORIGIN=https://media.staging.example.test
MEDIA_ALLOWED_ORIGINS=https://staging.example.test
MEDIA_API_HOST=127.0.0.1
MEDIA_API_PORT=3002
SOCKET_ALLOWED_ORIGINS=https://staging.example.test
SOCKET_HOST=127.0.0.1
PORT=3001
DEPLOYMENT_ENV=staging
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Retain existing social-provider settings; new communications require no paid media API.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# VPS media API only; never configure private storage/FFmpeg on Netlify.
# Persistent filesystem outside checkout and every webroot. No Nginx alias/static serving.
# Staging must use a distinct directory and database; this is the production directory.
VOICE_STORAGE_DIR=/srv/goga/private-voice
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VOICE_STORAGE_QUOTA_BYTES=1073741824
VOICE_STORAGE_RESERVE_BYTES=1073741824
VOICE_STORAGE_MAX_FILES=10000
# Native one-to-one calls: self-hosted coturn, credentials generated server-side.
RTC_STUN_URLS=stun:turn.example.test:3478
TURN_URLS=turn:turn.example.test:3478?transport=udp,turn:turn.example.test:3478?transport=tcp,turns:turn.example.test:5349?transport=tcp
TURN_SHARED_SECRET=
# Staging-only browser validation; keep false for ordinary production calling.
NEXT_PUBLIC_RTC_FORCE_RELAY=false
# OFF until separate group capacity and self-hosted token-revocation reviews pass.
ENABLE_GROUP_CALLS=false
GROUP_CALL_SECURITY_REVIEWED=false
GROUP_CALL_MAX_PARTICIPANTS=3
# Retired room cleanup tombstones; keep longer than refreshed-token TTL + margin.
LIVEKIT_RETIRED_ROOM_TTL_MS=86400000
CALL_MAX_DURATION_MS=7200000
LIVEKIT_URL=wss://livekit.staging.example.test
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Direct media providers approved by the owner. Never wildcard arbitrary hosts.
WATCH_ALLOWED_HOSTS=
