# Copy to a local/staging secret store; do not commit real credentials.
# Runtime (single Next process + single Socket.IO process on the VPS).
DATABASE_URL=mysql://APP_USER:CHANGE_ME@127.0.0.1:3306/STAGING_DB?connection_limit=3&pool_timeout=10
APP_ORIGIN=https://staging.example.test
NEXT_PUBLIC_SOCKET_URL=https://socket.staging.example.test
SOCKET_ALLOWED_ORIGINS=https://staging.example.test
SOCKET_HOST=127.0.0.1
PORT=3001
DEPLOYMENT_ENV=staging
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Retain existing social-provider settings; new communications require no paid media API.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Private voice notes: persistent filesystem outside checkout and webroot; same Next process
# must serve uploads and authorized downloads. Never serve this directory with Nginx alias.
VOICE_STORAGE_DIR=/srv/goga/shared/voice
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VOICE_STORAGE_QUOTA_BYTES=1073741824
VOICE_STORAGE_RESERVE_BYTES=1073741824
VOICE_STORAGE_MAX_FILES=10000
# Native one-to-one calls: self-hosted coturn, credentials generated server-side.
RTC_STUN_URLS=stun:turn.example.test:3478
TURN_URLS=turn:turn.example.test:3478?transport=udp,turns:turn.example.test:5349?transport=tcp
TURN_SHARED_SECRET=
# OFF until separate group capacity and self-hosted token-revocation reviews pass.
ENABLE_GROUP_CALLS=false
GROUP_CALL_SECURITY_REVIEWED=false
GROUP_CALL_MAX_PARTICIPANTS=4
CALL_MAX_DURATION_MS=7200000
LIVEKIT_URL=wss://livekit.staging.example.test
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Direct media providers approved by the owner. Never wildcard arbitrary hosts.
WATCH_ALLOWED_HOSTS=
