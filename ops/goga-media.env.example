# Template only. Install as /etc/goga/media.env, root:root 0600, outside Git.
# This file is parsed by systemd EnvironmentFile, not sourced by a shell.
NODE_ENV=production
DEPLOYMENT_ENV=staging
MEDIA_API_HOST=127.0.0.1
MEDIA_API_PORT=3002
MEDIA_API_PUBLIC_ORIGIN=https://media.staging.example.test
MEDIA_ALLOWED_ORIGINS=https://staging.example.test
# Existing MySQL, environment-specific DML account. Never put a real URL in Git.
DATABASE_URL="mysql://MEDIA_APP_USER:REPLACE_SECURELY@127.0.0.1:3306/STAGING_DB?connection_limit=2&pool_timeout=10"
CLERK_SECRET_KEY=REPLACE_SECURELY
# Optional JWT verification public key. If used, maintain its rotation procedure.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----"
VOICE_STORAGE_DIR=/srv/goga/private-voice
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VOICE_STORAGE_QUOTA_BYTES=1073741824
VOICE_STORAGE_RESERVE_BYTES=1073741824
VOICE_STORAGE_MAX_FILES=10000
