# REVIEW TEMPLATE ONLY: never install without administrator approval.
# Substitute verified interfaces/addresses/certificate paths securely.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=SET_IN_PRIVATE_SERVER_CONFIG
realm=turn.example.test
server-name=turn.example.test
cert=/PATH/TO/APPROVED/fullchain.pem
pkey=/PATH/TO/APPROVED/privkey.pem
min-port=49160
max-port=49200
total-quota=32
user-quota=4
max-bps=1250000
# Aggregate traffic cap: staging starting point, bytes/second; measure before release.
bps-capacity=3000000
stale-nonce=600
no-multicast-peers
no-cli
no-tlsv1
no-tlsv1_1
# Do not allow the relay to reach internal/private services.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Bind listening-ip/relay-ip/external-ip only after read-only network audit.
# Set process memory/CPU limits and restricted service user in reviewed systemd unit.

# Options reviewed against the upstream example; verify the actual installed package version.
# https://github.com/coturn/coturn/blob/master/examples/etc/turnserver.conf
